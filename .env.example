# Telegram Bot (optional - only for demo interface)
# Get token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# Dashboard (optional)
DASHBOARD_PORT=3100

# Safety (DO NOT CHANGE)
LIVE_TRADING=false
KRAKEN_MODE=paper

# LLM (optional, defaults to none)
LLM_PROVIDER=none

# Sage AI Co-Pilot (optional) — advisory only, never executes trades.
# Add your key here to enable Sage live Q&A. Leave empty to keep it off.
ANTHROPIC_API_KEY=

# Kraken read-only account (OPTIONAL) — shows your REAL balance as a read-only view.
# Create a key on Kraken with permission: Query Funds ONLY (no Create/Cancel Order, no Withdraw).
# The agent only READS your balance — it never trades or withdraws. Leave empty for paper-only.
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
